// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Event {
  id                     String   @id @default(cuid())
  title                  String
  description            String   @db.Text
  slug                   String   @unique
  startDate              DateTime
  endDate                DateTime
  registrationStartDate  DateTime
  registrationEndDate    DateTime
  location               String
  maxParticipants        Int
  price                  Float
  isActive               Boolean  @default(true)
  isFree                 Boolean  @default(false)
  formMode               EventFormMode @default(FIXED_ONLY)
  dynamicFormFields      Json?
  fixedFieldsConfig      Json?
  shirtConfig            Json?
  bannerUrl              String?
  paymentConfig          Json?    @default("{}")
  allowBatchRegistration Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  registrations          Registration[]
  batches                EventBatch[]
  orders                 Order[]

  @@map("events")
}

// Lote de inscrição (tier de preço/vagas/período) de um evento pago.
model EventBatch {
  id             String         @id @default(cuid())
  eventId        String
  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime
  quota          Int?
  priority       Int            @default(0)
  price          Float
  priceWithShirt Float?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  registrations  Registration[]

  @@index([eventId])
  @@map("event_batches")
}

model Registration {
  id              String            @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  email           String?
  cpf             String
  phone           String?
  status          RegistrationStatus @default(PENDING)
  paymentMethod   PaymentMethod
  paymentId       String?
  paymentError    String?
  paymentDetails  Json?
  dynamicFormData Json?
  wantsShirt      Boolean?          @default(false)
  shirtSize       String?
  notes             String?            @db.Text
  manualPaymentType ManualPaymentType?
  cashResponsible   String?
  checkedInAt     DateTime?
  batchId         String?
  batch           EventBatch?      @relation(fields: [batchId], references: [id])
  orderId         String?
  order           Order?           @relation(fields: [orderId], references: [id])
  refundRequests  RefundRequest[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([batchId])
  @@index([orderId])
  @@map("registrations")
}

// Unidade de pagamento (ADR-001). Agrupa N inscrições em um único checkout.
// order_nsu no gateway = "ord_" + id; o fluxo individual legado segue com
// order_nsu = registration.id e orderId nulo.
model Order {
  id                   String             @id @default(cuid())
  eventId              String
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type                 OrderType          @default(BATCH)
  status               RegistrationStatus @default(PENDING)
  paymentMethod        PaymentMethod      @default(INFINITE_PAY)
  // Referência do link de checkout vigente (null = precisa gerar novo link)
  paymentId            String?
  paymentError         String?
  // Payload bruto do gateway + history[] de eventos (saída de participante etc.)
  paymentDetails       Json?
  totalValue           Float
  transactionNsu       String?
  invoiceSlug          String?
  checkoutUrl          String?
  receiptUrl           String?
  amountCents          Int?
  paidAmountCents      Int?
  paidAt               DateTime?
  // Só para SHIRT_ONLY: inscrição confirmada que está comprando a camisa
  targetRegistrationId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  registrations        Registration[]

  @@index([eventId])
  @@index([transactionNsu])
  @@map("orders")
}

// Solicitação/registro de cancelamento e estorno (req. 12). O estorno é manual
// no app da InfinitePay (não há API): esta tabela organiza e audita o processo.
model RefundRequest {
  id             String              @id @default(cuid())
  registrationId String
  registration   Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reason         String              @db.Text
  origin         RefundOrigin        @default(PARTICIPANT)
  status         RefundRequestStatus @default(OPEN)
  resolution     RefundResolution?
  adminNotes     String?             @db.Text
  refundedAmount Float?
  refundedAt     DateTime?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([registrationId])
  @@index([status])
  @@map("refund_requests")
}

enum RefundOrigin {
  PARTICIPANT
  ADMIN
}

enum RefundRequestStatus {
  OPEN
  IN_CONTACT
  RESOLVED
}

enum RefundResolution {
  REFUNDED
  DENIED
  WITHDRAWN
  CANCELLED_NO_REFUND
}

enum OrderType {
  REGISTRATION
  BATCH
  SHIRT_ONLY
}

enum ManualPaymentType {
  PIX
  CASH
  CARD
}

model AppSettings {
  id                   String         @id @default("singleton")
  activePaymentGateway PaymentGateway @default(INFINITE_PAY)
  updatedAt            DateTime       @updatedAt

  @@map("app_settings")
}

model Admin {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        AdminRole @default(ADMIN)
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("admins")
}

model PageView {
  id          String   @id @default(cuid())
  page        String   // URL da página visitada
  referrer    String?  // Página de origem
  userAgent   String?  // User agent do navegador
  sessionId   String?  // ID da sessão do usuário
  latitude    Float?   // Latitude da localização
  longitude   Float?   // Longitude da localização
  city        String?  // Cidade
  country     String?  // País
  createdAt   DateTime @default(now())

  @@map("page_views")
  @@index([page])
  @@index([sessionId])
  @@index([createdAt])
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentMethod {
  MERCADO_PAGO
  INFINITE_PAY
  MANUAL
  FREE
}

enum PaymentGateway {
  MERCADO_PAGO
  INFINITE_PAY
}

enum EventFormMode {
  FIXED_ONLY
  DYNAMIC_ONLY
  BOTH
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  CHECKIN
  SUPPORT
}

// Auditoria InfinitePay (req. 6): importação do extrato CSV exportado do painel.
// O extrato não tem NSU: externalId é um hash estável da linha (ver statementParser).
model StatementImport {
  id           String           @id @default(cuid())
  fileName     String
  importedById String
  importedByName String?
  periodStart  DateTime?
  periodEnd    DateTime?
  totalRows    Int
  createdAt    DateTime         @default(now())
  entries      StatementEntry[]

  @@map("statement_imports")
}

model StatementEntry {
  id             String             @id @default(cuid())
  importId       String
  import         StatementImport    @relation(fields: [importId], references: [id], onDelete: Cascade)
  externalId     String
  kind           StatementEntryKind
  payerName      String?
  description    String?
  // Positivo = entrada, negativo = saída
  amountCents    Int
  paidAt         DateTime
  // Linha original; só deve sair em rotas ADMIN+
  raw            Json
  matchStatus    MatchStatus        @default(UNMATCHED)
  registrationId String?
  orderId        String?
  matchNote      String?
  // Possíveis correspondências para vínculo manual (ids + rótulo + pontuação)
  suggestions    Json?
  createdAt      DateTime           @default(now())

  @@index([importId])
  @@index([externalId])
  @@map("statement_entries")
}

enum StatementEntryKind {
  PIX_RECEIVED
  PIX_SENT
  SALES_DEPOSIT
  OTHER
}

enum MatchStatus {
  MATCHED
  AMOUNT_MISMATCH
  UNMATCHED
  DUPLICATE
  DUPLICATE_PAYMENT
  ACCOUNT_MOVEMENT
  RESOLVED_MANUAL
  IGNORED
}
